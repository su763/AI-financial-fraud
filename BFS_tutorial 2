      "source": [
        "from collections import deque\n",
        "graph = {\n",
        "    'A': [('B', 5), ('C', 10)],\n",
        "    'B': [('A', 5), ('D', 8)],\n",
        "    'C': [('A', 10), ('D', 3)],\n",
        "    'D': [('B', 8), ('C', 3)]\n",
        "}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "def bfs(graph, start):\n",
        "    visited = set()\n",
        "    queue = deque([(start, [start], 0)])  # (current_node, path, distance)\n",
        "\n",
        "    visited.add(start)\n",
        "\n",
        "    results = {}\n",
        "    visit_order = []\n",
        "\n",
        "    while queue:\n",
        "        node, path, dist = queue.popleft()\n",
        "        visit_order.append(node)\n",
        "\n",
        "        results[node] = (path, dist)\n",
        "\n",
        "        for neighbor, weight in graph[node]:\n",
        "            if neighbor not in visited:\n",
        "                visited.add(neighbor)\n",
        "                queue.append((neighbor, path + [neighbor], dist + weight))\n",
        "\n",
        "    return visit_order, results"
      ],
      "metadata": {
        "id": "csn9Lhw_6aQO"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "visit_order, results = bfs(graph, 'A')\n",
        "print(\"Visit Order:\", visit_order)"
      ],
